# Dossier des données de l'atelier (modèles, projets, sauvegardes).
# Les valeurs par défaut proviennent de config/storage.json.
# Ce fichier est un exemple : il n'est pas exécuté ni chargé automatiquement.
# Pour un autre volume, exporter les DEUX variables dans le terminal :
# export OPENCLAW_LOCAL_FEDORA_MOUNT=/autre-volume
# export OPENCLAW_LOCAL_FEDORA_ROOT=/autre-volume/IA/Openclaw

# Chemin du dépôt, seulement pour le développement et les tests.
# OPENCLAW_LOCAL_FEDORA_REPO=/path/to/OPENCLAW_LOCAL_FEDORA
