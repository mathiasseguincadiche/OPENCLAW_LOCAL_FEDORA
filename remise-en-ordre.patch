+  native-prompt-budget:
+    # Real pinned OpenClaw against a fake local Ollama: catches truncated instructions
+    # and prompts that do not fit the daily context, which simulated tests cannot see.
+    name: native-prompt-budget
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+      - name: Set up Python
+        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7
+        with:
+          python-version: "3.12"
+          cache: pip
+      - name: Set up Node
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
+        with:
+          node-version: "24"
+      - name: Install repository
+        run: python -m pip install -e .
+      - name: Install the pinned OpenClaw and Parallel plugin
+        run: |
+          pin="$(python -c 'from pathlib import Path; from clawfedora.core_config import root_contract; print(root_contract(Path("."), "runtime_versions.yaml")["openclaw"]["version"])')"
+          mkdir -p "$RUNNER_TEMP/openclaw"
+          cd "$RUNNER_TEMP/openclaw"
+          npm init -y >/dev/null
+          npm install --no-audit --no-fund --ignore-scripts "openclaw@$pin" "@openclaw/parallel-plugin@$pin"
+          echo "$RUNNER_TEMP/openclaw/node_modules/.bin" >> "$GITHUB_PATH"
+          echo "OPENCLAW_SCHEMA_PARALLEL_PATH=$RUNNER_TEMP/openclaw/node_modules/@openclaw/parallel-plugin" >> "$GITHUB_ENV"
+      - name: Native configuration schema
+        run: python scripts/validation/check_openclaw_schema.py
+      - name: Native prompt budget
+        run: python scripts/validation/check_prompt_budget.py
